  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "github-slugger": "2.0.0",
    "parse5": "8.0.1",
    "proper-lockfile": "4.1.2",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
