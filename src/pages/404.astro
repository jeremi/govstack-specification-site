---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { readPublication } from '../../scripts/publication.mjs';
const publication = readPublication();
---
<StarlightPage frontmatter={{ title: 'Page not found', description: 'This local publication page could not be found.', editUrl: false, prev: false, next: false }}>
  <p>This page may have moved while the publication is being edited.</p>
  <p><a href={import.meta.env.BASE_URL}>Return to {publication.title}</a> or use search.</p>
</StarlightPage>
